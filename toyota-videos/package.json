{
  "name": "toyota-videos",
  "version": "1.0.0",
  "description": "Seamless 800x800 automotive loops for the Znachok ESP32-P4 display",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:pulse": "remotion render ToyotaPulseP4 out/toyota-pulse-p4.mp4 --codec=h264 --crf=18",
    "render:circuit": "remotion render ToyotaNightCircuitP4 out/toyota-night-circuit-p4.mp4 --codec=h264 --crf=18",
    "render:eye": "remotion render ToyotaEyePortalP4 out/toyota-eye-portal-p4.mp4 --codec=h264 --crf=18",
    "render:celica-night": "remotion render ToyotaCelicaNightRunP4 out/toyota-celica-night-run-p4.mp4 --codec=h264 --crf=18",
    "render:kintsugi": "remotion render ToyotaKintsugiCoreP4 out/toyota-kintsugi-core-p4.mp4 --codec=h264 --crf=18",
    "render:celica-blueprint": "remotion render ToyotaCelicaBlueprintP4 out/toyota-celica-blueprint-p4.mp4 --codec=h264 --crf=18",
    "render:celica-laser": "remotion render ToyotaCelicaLaserResurrectionP4 out/toyota-celica-laser-resurrection-p4.mp4 --codec=h264 --crf=18",
    "render:portal-engine": "remotion render ToyotaPortalEngineP4 out/toyota-portal-engine-p4.mp4 --codec=h264 --crf=18",
    "render:perspective-temple": "remotion render ToyotaPerspectiveTempleP4 out/toyota-perspective-temple-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:bmw-joy": "remotion render BmwJoyShiftP4 out/bmw-joy-shift-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:bmw-m": "remotion render BmwMVelocityP4 out/bmw-m-velocity-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:bmw-orbit": "remotion render BmwOrbitP4 out/bmw-orbit-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:bmw-premium": "remotion render BmwPremiumMorphP4 out/bmw-premium-morph-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:toyota-wheel-morph": "remotion render ToyotaWheelMorphP4 out/toyota-wheel-morph-p4.mp4 --codec=h264 --crf=18 --muted",
    "render:bmw": "npm run render:bmw-joy && npm run render:bmw-m && npm run render:bmw-orbit",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
